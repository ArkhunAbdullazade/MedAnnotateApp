# Docker/local development settings.
# Replace values before running outside a disposable local environment.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=meddatadb

# Single quotes are required to preserve bcrypt's dollar signs in Docker Compose.
AUTHORIZATION_ACCESS_PASSWORD_HASH='replace-with-bcrypt-hash'
PUBLIC_HOST=research.example.org
# Set to the actual address of your reverse proxy as seen by the app container.
REVERSE_PROXY_IP=127.0.0.1

# SMTP is not required for research signup/sign-in.
