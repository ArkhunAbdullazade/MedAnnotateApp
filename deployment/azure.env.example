# Copy to .env.azure at the repository root. Fill locally; keep the copy private.
# Single quotes preserve dollar signs in passwords and bcrypt hashes.
AZURE_POSTGRES_CONNECTION_STRING='Host=replace-me.postgres.database.azure.com;Port=5432;Database=medannotate;Username=medannotate_app;Password=replace-me;SSL Mode=VerifyFull'
AUTHORIZATION_ACCESS_PASSWORD_HASH='replace-with-existing-bcrypt-hash'
PUBLIC_HOST=research.example.org
# Inspect the Docker network gateway, then verify the actual proxy source address.
REVERSE_PROXY_IP=127.0.0.1
