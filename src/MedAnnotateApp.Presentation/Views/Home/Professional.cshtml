@model MedData

@{
    var medDataKeywords = (ViewBag.MedDataKeywords as IList<string?>)?.Where(keyword => !string.IsNullOrWhiteSpace(keyword)).Distinct().ToList();
    var counter = ViewBag.Counter as string;

}

<link rel="stylesheet" href="~/css/annotationWorkspace.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
@Html.AntiForgeryToken()

@if (Model != null)
{
    <div class="annotation-workspace">
        <div class="left-column">
            <div class="description-panel">
                <div class="header-text" data-keyword-count="@(medDataKeywords?.Count ?? 0)">
                    <p>@DescriptionKeywords.Highlight(Model.ImageDescription, medDataKeywords)@if (!string.IsNullOrWhiteSpace(Model.Diagnosis) && Model.Diagnosis != "u" && Model.Diagnosis != "na")
                        {<text>@(" Diagnosis: " + Model.Diagnosis)</text>}</p>
                </div>
                <div class="description-tools" role="group" aria-label="Description text">
                    <button type="button" class="description-tool" data-size-step="1" aria-label="Larger description text">A+</button>
                    <button type="button" class="description-tool" data-size-step="-1" aria-label="Smaller description text">A−</button>
                    <button type="button" class="description-tool" data-description-open aria-label="Read the whole description" aria-haspopup="dialog"><i class="bi bi-arrows-angle-expand" aria-hidden="true"></i></button>
                </div>
            </div>
            <div id="annotation-status" class="annotation-status" role="status" aria-live="polite">Loading image and saved responses…</div>

            <div class="main-content">
                <div class="annotation-section">
                    <div class="image-viewport">
                    <div id="image-container">
                        <img id="sourceImage"
                            src="@Model.ImageUrl"
                            alt="Image for Annotation" style="display:none; max-width: 100%; max-height: 100%; object-fit: contain;">
                        <div id="canvasContainer">
                            <canvas id="mainCanvas"></canvas>
                        </div>
                    </div>
                    <div class="buttons-section">
                        <a asp-controller="Identity" asp-action="Filters" class="btn filters-button" data-description="Choose which specialities, body regions and image modalities your images come from. Every list is optional.">Filters</a>
                        <div class="decision-buttons">
                            <button
                                data-description="Click if you are certain that it is not possible to visually annotate the current medical term in this particular image"
                                id="not-present-button" type="button" class="button btn btn-block">
                                Not Visible/Abstract
                            </button>
                            <button
                                data-description="Click if you are unsure whether you want to annotate this case, or whether the current medical term is present in the image at all, or of its exact location."
                                id="skip-button" type="button" class="button btn btn-block">
                                Uncertain/Skip
                            </button>
                            <button id="next-button" type="button" class="button btn btn-block" disabled>
                                Save and Next Term
                            </button>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="right-column">
            <div class="metadata">
                <div class="metadata-inner">
                    @if (!string.IsNullOrWhiteSpace(Model.Speciality) && Model.Speciality != "u" && Model.Speciality != "na")
                    {
                        <p><strong>Speciality: </strong>@Model.Speciality</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Modality) && Model.Modality != "u" && Model.Modality != "na")
                    {
                        <p><strong>Image Modality: </strong>@Model.Modality</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Sex) && Model.Sex != "u" && Model.Sex != "na")
                    {
                        <p><strong>Sex: </strong>@Model.Sex</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Age) && Model.Age != "u" && Model.Age != "na")
                    {
                        <p><strong>Age: </strong>@Model.Age</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SkinTone) && Model.SkinTone != "u" && Model.SkinTone != "na")
                    {
                        <p><strong>Skin Tone: </strong>@Model.SkinTone</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.BodyRegion) && Model.BodyRegion != "u" && Model.BodyRegion != "na")
                    {
                        <p><strong>Body Region: </strong>@Model.BodyRegion</p>
                    }
                </div>
            </div>
            @* Both notes open as panels under their buttons, so the image and terms stay in view; each is saved with the term. *@
            <div class="note-panels" data-note-panels>
                <div class="note-toggles">
                    <button type="button" class="note-toggle" aria-expanded="false" aria-controls="comments-panel" data-note-toggle="comments-panel">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i> Comments <span class="note-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="note-toggle" aria-expanded="false" aria-controls="problem-panel" data-note-toggle="problem-panel">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Report a technical problem <span class="note-dot" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="note-panel" id="comments-panel">
                    <div class="note-panel-inner">
                        <label for="comments" class="visually-hidden">Comments on this term</label>
                        <textarea class="form-control" id="comments" maxlength="4000" placeholder="Leave your comments about this term here..."></textarea>
                    </div>
                </div>
                <div class="note-panel" id="problem-panel">
                    <div class="note-panel-inner" data-problem-report>
                        <label for="technical-problem" class="visually-hidden">Technical problem with this term</label>
                        <textarea class="form-control" id="technical-problem" maxlength="4000" placeholder="Describe a technical problem"></textarea>
                        @* Send now always works, even when the image or tools do not; unsent text is saved with the term's answer. *@
                        <div class="problem-actions">
                            <span class="problem-status" data-problem-status role="status" aria-live="polite"></span>
                            <button type="button" class="problem-send" data-problem-send><i class="bi bi-send" aria-hidden="true"></i> Send now</button>
                        </div>
                    </div>
                </div>
            </div>
            @* Findings the specialist outlined and named with the Custom annotation tool (customAnnotations.js). *@
            <section class="custom-list" id="custom-list" aria-labelledby="custom-list-title" hidden>
                <h2 class="custom-list-title" id="custom-list-title">Custom annotations <span class="custom-count" id="custom-count">0</span></h2>
                <ul class="custom-items" id="custom-items"></ul>
            </section>
        </div>
    </div>
    <dialog id="description-dialog" class="annotation-dialog description-dialog" aria-labelledby="description-dialog-title">
        <div class="annotation-dialog-header">
            <div>
                <h2 class="annotation-dialog-title" id="description-dialog-title">Image description</h2>
                <p class="annotation-dialog-note" id="description-dialog-term"></p>
            </div>
            <div class="description-tools description-tools-row" role="group" aria-label="Text size">
                <button type="button" class="description-tool" data-size-step="-1" title="Smaller text" aria-label="Smaller text">A−</button>
                <button type="button" class="description-tool" data-size-step="1" title="Larger text" aria-label="Larger text">A+</button>
            </div>
            <button type="button" class="btn-close" aria-label="Close"></button>
        </div>
        <div class="description-dialog-text" tabindex="-1" autofocus></div>
    </dialog>
}
else
{
    <div class="centered-container">
        <div class="no-data-message">
            <div class="no-data-icon">
                <i class="bi bi-file-earmark-x"></i>
            </div>
            <h3>
                @(AnnotationProgress.IsComplete(counter) ? "All matching images have been completed." : "No available images match all of your selected filters.")
            </h3>
            <p>@(AnnotationProgress.IsComplete(counter) ? "Saved annotations remain in the database for research evaluation." : "Images may be completed, assigned to another specialist, or missing the selected metadata. Choose different filters or ask the research team to refine the image metadata.")</p>
            <a asp-controller="Identity" asp-action="Filters" class="button">Filters</a>
            <button id="end-button-center" type="button" class="button mt-4">
                Log Out
            </button>
        </div>
    </div>
}
@section HeaderActions {
    <span class="header-progress">Progress: <span id="counter-value">@counter</span></span>
    <button id="end-button" type="button" class="header-logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log Out</button>
}

<script nonce="@Context.Items[SecurityHeaders.NonceKey]">
    window.annotatedMedData = @Html.Raw(Json.Serialize(AnnotationImage.From(Model)));
</script>
@* First, so it can report errors from every script after it. *@
<script src="~/js/problemReport.js" asp-append-version="true"></script>
<script src="~/js/hoverDescriptions.js" asp-append-version="true"></script>
<script src="~/js/annotationGeometry.js" asp-append-version="true"></script>
<script src="~/js/canvas.js" asp-append-version="true"></script>
<script src="~/js/assignmentWatch.js" asp-append-version="true"></script>
<script src="~/js/descriptionReader.js" asp-append-version="true" defer></script>
<script src="~/js/notePanels.js" asp-append-version="true" defer></script>
<script src="~/js/customAnnotations.js" asp-append-version="true" defer></script>
<script src="~/js/professionalPage.js" asp-append-version="true" defer></script>
