@model MedData

@{
    var counter = ViewBag.Counter as string;
}

<link rel="stylesheet" href="~/css/studentPage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/annotationWorkspace.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
@Html.AntiForgeryToken()

@if (Model != null)
{
    <div class="annotation-workspace">
        <div class="left-column">
            <div class="annotation-instructions">Draw a rectangle or closed outline, enter a label and save the group. Submit Annotations saves all groups to the database. Unsaved changes are lost if you leave this page.</div>
            <div id="annotation-status" class="annotation-status" role="status" aria-live="polite">Loading image…</div>
            <div class="image-viewport">
            <div id="image-container">
                <img id="sourceImage"
                    src="@Model.ImageUrl"
                    alt="Medical Image" style="display:none; max-width: 100%; max-height: 100%; object-fit: contain;">
                <div id="canvasContainer">
                    <canvas id="mainCanvas"></canvas>
                </div>
            </div>
            </div>

            <div class="buttons-section">
                <button id="submit-button" class="primary-button" disabled>Submit Annotations</button>
            </div>
        </div>

        <div class="right-column student-mode">
            <div class="metadata">
                <div class="metadata-inner">
                    <div class="metadata-item">
                        <span class="label">Specialty:</span>
                        <span class="value">@Model.Speciality</span>
                    </div>
                    <div class="metadata-item">
                        <span class="label">Body Region:</span>
                        <span class="value">@Model.BodyRegion</span>
                    </div>
                    <div class="metadata-item">
                        <span class="label">Image Modality:</span>
                        <span class="value">@Model.Modality</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Diagnosis) && Model.Diagnosis != "u" && Model.Diagnosis != "na")
                    {
                        <div class="metadata-item">
                            <span class="label">Diagnosis:</span>
                            <span class="value">@Model.Diagnosis</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Sex) && Model.Sex != "u" && Model.Sex != "na")
                    {
                        <div class="metadata-item">
                            <span class="label">Sex:</span>
                            <span class="value">@Model.Sex</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Age) && Model.Age != "u" && Model.Age != "na")
                    {
                        <div class="metadata-item">
                            <span class="label">Age:</span>
                            <span class="value">@Model.Age</span>
                        </div>
                    }
                </div>
            </div>

            <div class="annotation-section">
                <div class="annotations-header">
                    <h4>Annotation Groups</h4>
                    <div class="annotations-info">
                        Select Edit to change an annotation group.
                    </div>
                </div>
                <div id="annotations-list" class="annotations-list">
                    <div class="empty-annotations-message">
                        No annotations yet. Use the tools to annotate the image.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="centered-container">
        <div class="no-data-message">
            <div class="no-data-icon">
                <i class="bi bi-file-earmark-x"></i>
            </div>
            <h3>@(AnnotationProgress.IsComplete(counter) ? "All matching images have been completed." : "No available images match all of your selected filters.")</h3>
            <p>@(AnnotationProgress.IsComplete(counter) ? "Saved annotations remain in the database for research evaluation." : "Images may be completed, assigned to another user, or missing the selected metadata.")</p>
            <a asp-controller="Identity" asp-action="Filters" class="button">Change filters</a>
            <button id="end-button-center" type="button" class="button mt-4">
                Log Out
            </button>
        </div>
    </div>
}

<div class="logout-section">
    <a asp-controller="Identity" asp-action="Filters" class="btn btn-outline-secondary">Change filters</a>
    <div class="counter">Team progress in selected filters: @counter</div>
    <button type="button" id="end-button" class="end-button">Log Out</button>
</div>

<script>
    // Flag to identify student page for canvas.js processing
    window.isStudentPage = true;
    
    // Student tools need image identity, not the specialist description or terms.
    window.annotatedMedData = @Html.Raw(Json.Serialize(AnnotationImage.From(Model)));
</script>

<script src="~/js/annotationGeometry.js" asp-append-version="true"></script>
<script src="~/js/canvas.js" asp-append-version="true"></script>
<script src="~/js/studentCanvas.js" asp-append-version="true"></script>
<script src="~/js/studentPage.js" asp-append-version="true"></script>
