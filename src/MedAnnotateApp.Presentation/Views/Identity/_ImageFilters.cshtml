@model MedAnnotateApp.Presentation.Dtos.ImageFiltersDto
@using MedAnnotateApp.Presentation.Dtos
@{
    // Image modality first: it matches a clinician's reading skill and is the most reliable label; speciality narrows
    // to familiar diseases; body region mainly helps organ-focused experts. Only image modality is required.
    var groups = new[]
    {
        (Name: "ImageModality", Label: "Image modality", Options: ImageFilterOptions.ImageModalities, Selected: Model?.ImageModality, Required: true),
        (Name: "Speciality", Label: "Speciality", Options: ImageFilterOptions.Specialities, Selected: Model?.Speciality, Required: false),
        (Name: "BodyRegion", Label: "Body region", Options: ImageFilterOptions.BodyRegions, Selected: Model?.BodyRegion, Required: false)
    };
    var compact = ViewData["CompactImageFilters"] as bool? == true;
}
@if (!compact)
{
    <h2>Choose images to annotate</h2>
    <p id="image-filter-help">Select at least one image modality. Speciality and body region are optional: leaving one empty includes all of its options. You can select several options in a list.</p>
}
<div class="row g-3" @(compact ? "" : "aria-describedby=image-filter-help")>
    @foreach (var group in groups)
    {
        <fieldset class="col-md-4" data-filter-group="@group.Name" data-filter-label="@group.Label" data-filter-required="@(group.Required ? "true" : null)" aria-describedby="image-filter-error">
            <legend>@group.Label @if (group.Required) { <span class="filter-required">(required)</span> } else { <span class="text-muted">(optional)</span> }</legend>
            <div class="border rounded p-2 image-filter-options">
                @for (var index = 0; index < group.Options.Length; index++)
                {
                    var option = group.Options[index];
                    var selected = group.Selected?.Contains(option, StringComparer.OrdinalIgnoreCase) == true;
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="@group.Name" id="@group.Name-@index" value="@option" checked="@selected" />
                        <label class="form-check-label" for="@group.Name-@index">@option</label>
                    </div>
                }
            </div>
        </fieldset>
    }
</div>
@* One message for the whole form: only image modality can be missing. *@
<p id="image-filter-error" class="text-danger" data-filter-error aria-live="polite"></p>
