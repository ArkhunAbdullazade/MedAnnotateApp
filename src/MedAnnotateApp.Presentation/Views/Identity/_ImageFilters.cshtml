@model MedAnnotateApp.Presentation.Dtos.ImageFiltersDto
@using MedAnnotateApp.Presentation.Dtos
@{
    var groups = new[]
    {
        (Name: "Speciality", Label: "Speciality", Options: ImageFilterOptions.Specialities, Selected: Model?.Speciality),
        (Name: "BodyRegion", Label: "Body region", Options: ImageFilterOptions.BodyRegions, Selected: Model?.BodyRegion),
        (Name: "ImageModality", Label: "Image modality", Options: ImageFilterOptions.ImageModalities, Selected: Model?.ImageModality)
    };
}
<h2 class="h5">Choose images to annotate</h2>
<p id="image-filter-help">Select at least one option in each list. You can select multiple options. Images must match a selection in all three lists.</p>
<div class="row g-3">
    @foreach (var group in groups)
    {
        <fieldset class="col-md-4" data-required-selection="@group.Name" aria-describedby="image-filter-help @group.Name-error">
            <legend class="h6">@group.Label <span class="text-muted">(required)</span></legend>
            <div class="border rounded p-2 image-filter-options">
                @for (var index = 0; index < group.Options.Length; index++)
                {
                    var option = group.Options[index];
                    var selected = group.Selected?.Contains(option, StringComparer.OrdinalIgnoreCase) == true;
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="@group.Name" id="@group.Name-@index" value="@option" checked="@selected" />
                        <label class="form-check-label" for="@group.Name-@index">@option</label>
                    </div>
                }
            </div>
            <span id="@group.Name-error" class="text-danger" data-selection-error aria-live="polite"></span>
        </fieldset>
    }
</div>
