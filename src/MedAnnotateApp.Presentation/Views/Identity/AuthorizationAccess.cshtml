@model MedAnnotateApp.Presentation.Dtos.AuthorizationAccessDto

@{
    ViewBag.Title = "Research access";
}

<link rel="stylesheet" href="~/css/authForms.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

<section class="auth-page auth-focus">
    <div class="auth-card">
        <a class="auth-logo" asp-controller="Home" asp-action="Index"><img src="~/images/medannotate-logo.png" asp-append-version="true" alt="MedAnnotate" width="184" height="40" /></a>
        <h1>Research access</h1>
        <p class="auth-lead">Enter the shared research access password provided to you.</p>
        <form method="post" asp-action="PostAuthorizationAccess" asp-controller="Identity" class="mb-0">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <div class="auth-field">
                <label asp-for="Password" class="form-label">Research access password</label>
                <div class="password-field">
                    <input type="password" asp-for="Password" class="form-control" autocomplete="off" required />
                    <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-submit">Continue to sign in</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validationSummary.js" asp-append-version="true"></script>
    <script src="~/js/passwordToggle.js" asp-append-version="true"></script>
}
