@model MedAnnotateApp.Presentation.Dtos.AuthorizationAccessDto

@{
    ViewBag.Title = "Research access";
}

<link rel="stylesheet" href="~/css/authForms.css" asp-append-version="true" />

<section class="centered auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-11">
                <div class="card shadow-lg p-0 welcome-card">
                    <div class="row g-0 h-100">
                        <div class="col-md-7 welcome-column">
                            <div>
                                <h1 class="display-5 fw-bold ls-tight text-center brand-title brand-color">
                                    Research access
                                </h1>
                                <p class="mt-3 welcome-text">
                                    Enter the shared research access password provided by the researcher.
                                    You will then sign in or create your own account to annotate images.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-5 form-column">
                            <div class="card-body form-container">
                                <form method="post" asp-action="PostAuthorizationAccess" asp-controller="Identity" class="mb-0">                                    
                                    <div class="mb-3 w-100">
                                        <div asp-validation-summary="All" class="validation-summary-errors"></div>
                                    </div>

                                    <div class="w-100">
                                        <label asp-for="Password" class="form-label">Research access password</label>
                                        <input type="password" asp-for="Password" class="form-control" autocomplete="off" required />
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>

                                    <button type="submit" class="btn-submit">
                                        Continue to sign in
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validationSummary.js" asp-append-version="true"></script>
}
