@model MedAnnotateApp.Presentation.Dtos.ImageFiltersDto
@{
    ViewBag.Title = "Image selections";
}
<link rel="stylesheet" href="~/css/authForms.css" asp-append-version="true" />

<section class="card shadow-sm my-4 auth-page">
    <div class="card-body p-4">
        <h1 class="h3">Image selections</h1>
        <p>These selections apply whenever you open annotation work. Saved annotations stay available for matching images.</p>
        <form method="post" asp-controller="Identity" asp-action="Filters" data-image-filter-form>
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <partial name="_ImageFilters" model="Model" />
            <button type="submit" class="btn btn-danger mt-3">Save selections and continue</button>
        </form>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/imageFilters.js" asp-append-version="true"></script>
}
