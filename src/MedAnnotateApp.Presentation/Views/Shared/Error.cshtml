@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">We couldn’t complete that action</h1>
<p>Your last action may not have been saved. Return to your annotation page and check its save status before continuing.</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to annotations</a>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <strong>Error Details:</strong> @Model.ErrorMessage
    </div>
}

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
