@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="notice-page">
    <h1>We couldn’t complete that action</h1>
    <p>Your last action may not have been saved. Return to your annotation page and check its save status before continuing.</p>
    <div class="notice-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to annotations</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="notice-detail"><strong>Error details:</strong> @Model.ErrorMessage</p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="notice-detail"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>
