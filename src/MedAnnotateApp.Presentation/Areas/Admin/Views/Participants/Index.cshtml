@model ParticipantsViewModel
@{
    ViewData["Title"] = "Participants";
    ViewData["Subtitle"] = "Everyone who signed up, with their progress and current work. Admin accounts are not listed.";
}

<section class="admin-card">
    <div class="filter-toggle d-sm-none">
        <button class="btn btn-sm btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#participant-filters" aria-expanded="false" aria-controls="participant-filters">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filters@(new[] { Model.Role, Model.Search }.Count(value => !string.IsNullOrWhiteSpace(value)) is var active && active > 0 ? $" ({active} on)" : "")
        </button>
    </div>
    <form class="filter-bar collapse d-sm-flex" id="participant-filters" method="get">
        <div class="grow">
            <label class="form-label" for="search">Search</label>
            <input class="form-control form-control-sm" id="search" name="search" value="@Model.Search" placeholder="Name, email, university or code" />
        </div>
        <div>
            <label class="form-label" for="role">Role</label>
            <select class="form-select form-select-sm" id="role" name="role" data-autosubmit>
                <option value="">Everyone</option>
                <option value="specialist" selected="@(Model.Role == "specialist")">Specialists</option>
                <option value="student" selected="@(Model.Role == "student")">Students</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-search"></i> Apply</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-people"></i>@(Model.Total == 0 ? "Nobody has signed up yet." : "Nobody matches these filters.")</div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="table table-hover admin-table align-middle">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th class="d-none d-sm-table-cell">Role</th>
                        <th class="d-none d-xl-table-cell">Selections</th>
                        <th class="num">Completed</th>
                        <th class="num d-none d-md-table-cell">Partial</th>
                        <th class="num d-none d-md-table-cell">Answers</th>
                        <th class="num d-none d-sm-table-cell">Left for them</th>
                        <th class="d-none d-md-table-cell">Current lock</th>
                        <th>Last active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var person = row.Person;
                        <tr>
                            <td>
                                <span class="series-dot @(person.IsStudent ? "student" : "specialist") me-1 d-sm-none" title="@AdminUi.RoleLabel(person.Role)"></span><a class="fw-semibold" asp-action="Details" asp-route-id="@person.Id">@person.DisplayName</a>
                                <div class="muted small">@person.Email</div>
                            </td>
                            <td class="d-none d-sm-table-cell">
                                <span class="role-pill"><span class="series-dot @(person.IsStudent ? "student" : "specialist")"></span>@AdminUi.RoleLabel(person.Role)</span>
                                <div class="muted small text-nowrap">@(person.IsStudent ? "" : $"{person.ClinicalExperience} y experience")</div>
                            </td>
                            <td class="small selections d-none d-xl-table-cell">
                                <div class="truncate" title="@AdminUi.List(person.Speciality)">@AdminUi.List(person.Speciality)</div>
                                <div class="muted truncate" title="@AdminUi.List(person.ImageModality) · @AdminUi.List(person.BodyRegion)">@AdminUi.List(person.ImageModality) · @AdminUi.List(person.BodyRegion)</div>
                            </td>
                            <td class="num">@row.ImagesCompleted</td>
                            <td class="num d-none d-md-table-cell">@(row.PartialImages > 0 ? row.PartialImages.ToString() : "—")</td>
                            <td class="num d-none d-md-table-cell">@row.Responses</td>
                            <td class="num d-none d-sm-table-cell">
                                @if (row.OpenImagesLeft == 0)
                                {
                                    <span class="state state-stale"><i class="bi bi-hourglass-bottom"></i>0</span>
                                }
                                else { @row.OpenImagesLeft }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @foreach (var imageId in row.LockedImages)
                                {
                                    <a class="me-1" asp-controller="Images" asp-action="Details" asp-route-id="@imageId">#@imageId</a>
                                }
                                @if (row.LockedImages.Count == 0) { <span class="muted">—</span> }
                            </td>
                            <td class="text-nowrap"><time datetime="@AdminUi.Iso(row.LastActiveAt)" data-local="relative"></time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pager"><span>@Model.Rows.Count of @Model.Total participants</span></div>
    }
</section>
