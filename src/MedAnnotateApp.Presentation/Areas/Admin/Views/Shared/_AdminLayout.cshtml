@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var nav = new (string Controller, string Label, string Icon)[]
    {
        ("Dashboard", "Overview", "bi-speedometer2"),
        ("Images", "Images", "bi-images"),
        ("Locks", "Locks", "bi-lock"),
        ("Participants", "Participants", "bi-people"),
        ("Responses", "Responses", "bi-card-checklist"),
        ("Export", "Export", "bi-download"),
        ("Log", "Admin log", "bi-journal-text")
    };
    var message = TempData["AdminMessage"] as string;
    var messageKind = TempData["AdminMessageKind"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · MedAnnotate admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="admin-brand-mark"><i class="bi bi-bounding-box-circles"></i></span>
                <span>MedAnnotate <small>Admin</small></span>
            </a>
            <nav class="admin-nav" aria-label="Admin sections">
                @foreach (var item in nav)
                {
                    var active = string.Equals(controller, item.Controller, StringComparison.OrdinalIgnoreCase);
                    <a class="admin-nav-link @(active ? "active" : "")" asp-area="Admin" asp-controller="@item.Controller" asp-action="Index"
                       aria-current="@(active ? "page" : null)">
                        <i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span>
                    </a>
                }
            </nav>
            <form class="admin-signout" method="post" asp-area="Admin" asp-controller="Dashboard" asp-action="Logout">
                <span class="admin-user" title="@User.Identity?.Name"><i class="bi bi-person-circle"></i> @User.Identity?.Name</span>
                <button type="submit" class="btn btn-sm btn-outline-light w-100"><i class="bi bi-box-arrow-right"></i><span class="admin-signout-text"> Sign out</span></button>
            </form>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <h1 class="admin-title">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string subtitle)
                    {
                        <p class="admin-subtitle">@subtitle</p>
                    }
                </div>
                <div class="admin-actions">@await RenderSectionAsync("Actions", required: false)</div>
            </header>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-@(messageKind) alert-dismissible fade show admin-flash" role="status">
                    <i class="bi @(messageKind == "success" ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>@message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="confirm-title">Please confirm</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                </div>
                <div class="modal-body" id="confirm-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirm-ok">Release</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
