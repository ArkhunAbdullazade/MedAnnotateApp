@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var nav = new (string Controller, string Label, string Icon)[]
    {
        ("Dashboard", "Overview", "bi-speedometer2"),
        ("Images", "Images", "bi-images"),
        ("Locks", "Locks", "bi-lock"),
        ("Participants", "Participants", "bi-people"),
        ("Responses", "Responses", "bi-card-checklist"),
        ("Export", "Export", "bi-download"),
        ("Log", "Admin log", "bi-journal-text")
    };
    var message = TempData["AdminMessage"] as string;
    var messageKind = TempData["AdminMessageKind"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - Med Annotation App admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-header">
        <button class="btn admin-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#admin-sidebar"
                aria-controls="admin-sidebar" aria-label="Open the admin menu">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <a class="admin-wordmark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Med Annotation App</a>
        <span class="admin-badge">Admin</span>
        <div class="admin-header-end">
            <span class="admin-user d-none d-md-inline" title="Signed in as @User.Identity?.Name"><i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity?.Name</span>
            <form method="post" asp-area="Admin" asp-controller="Dashboard" asp-action="Logout">
                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Sign out">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="d-none d-sm-inline"> Sign out</span>
                </button>
            </form>
        </div>
    </header>

    <div class="admin-shell">
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" id="admin-sidebar" tabindex="-1" aria-labelledby="admin-menu-title">
            <div class="offcanvas-header d-lg-none">
                <span class="admin-wordmark fs-5" id="admin-menu-title">Med Annotation App</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#admin-sidebar" aria-label="Close the menu"></button>
            </div>
            <div class="admin-sidebar-inner">
                <nav class="admin-nav" aria-label="Admin sections">
                    @foreach (var item in nav)
                    {
                        var active = string.Equals(controller, item.Controller, StringComparison.OrdinalIgnoreCase);
                        <a class="admin-nav-link @(active ? "active" : "")" asp-area="Admin" asp-controller="@item.Controller" asp-action="Index"
                           aria-current="@(active ? "page" : null)">
                            <i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span>
                        </a>
                    }
                </nav>
            </div>
        </aside>
        <div class="admin-main">
            <div class="admin-topbar">
                <div class="admin-heading">
                    <h1 class="admin-title">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string subtitle)
                    {
                        <p class="admin-subtitle">@subtitle</p>
                    }
                </div>
                <div class="admin-actions">@await RenderSectionAsync("Actions", required: false)</div>
            </div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-@(messageKind) alert-dismissible fade show admin-flash" role="status">
                    <i class="bi @(messageKind == "success" ? "bi-check-circle" : "bi-exclamation-triangle") me-1" aria-hidden="true"></i>@message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="confirm-title">Please confirm</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                </div>
                <div class="modal-body" id="confirm-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirm-ok">Release</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
