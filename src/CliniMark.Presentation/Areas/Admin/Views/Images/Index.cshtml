@model ImagesViewModel
@{
    ViewData["Title"] = "Images";
    ViewData["Subtitle"] = "Every study image with its specialist and student status. Click a row for the annotations.";
    var q = Model.Query;
    var statusOptions = new[] { ("", "Any"), ("open", "Open"), ("in-progress", "In progress"), ("done", "Done") };
}

<section class="admin-card">
    <div class="filter-toggle d-sm-none">
        <button class="btn btn-sm btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#image-filters" aria-expanded="false" aria-controls="image-filters">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filters@(new[] { q.Search, q.Speciality, q.Modality, q.BodyRegion, q.SpecialistStatus, q.StudentStatus }.Count(value => !string.IsNullOrWhiteSpace(value)) is var active && active > 0 ? $" ({active} on)" : "")
        </button>
    </div>
    <form class="filter-bar collapse d-sm-flex" id="image-filters" method="get">
        <div class="grow">
            <label class="form-label" for="search">Search</label>
            <input class="form-control form-control-sm" id="search" name="search" value="@q.Search" placeholder="Image ID, PMCID, diagnosis, description or term" />
        </div>
        @foreach (var (name, label, values, selected) in new[]
        {
            ("speciality", "Speciality", Model.Categories.Specialities, q.Speciality),
            ("modality", "Modality", Model.Categories.Modalities, q.Modality),
            ("bodyRegion", "Body region", Model.Categories.BodyRegions, q.BodyRegion)
        })
        {
            <div>
                <label class="form-label" for="@name">@label</label>
                <select class="form-select form-select-sm" id="@name" name="@name" data-autosubmit>
                    <option value="">All</option>
                    @foreach (var value in values)
                    {
                        <option value="@value" selected="@(value == selected)">@AdminUi.Title(value)</option>
                    }
                </select>
            </div>
        }
        <div>
            <label class="form-label" for="specialistStatus">Specialist</label>
            <select class="form-select form-select-sm" id="specialistStatus" name="specialistStatus" data-autosubmit>
                @foreach (var (value, label) in statusOptions.Append(("partial", "Has saved answers, not done")).Append(("removed", "Removed from study")))
                {
                    <option value="@value" selected="@(value == (q.SpecialistStatus ?? ""))">@label</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="studentStatus">Student</label>
            <select class="form-select form-select-sm" id="studentStatus" name="studentStatus" data-autosubmit>
                @foreach (var (value, label) in statusOptions)
                {
                    <option value="@value" selected="@(value == (q.StudentStatus ?? ""))">@label</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-search"></i> Apply</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>

    @if (Model.Images.Total == 0)
    {
        <div class="empty-state"><i class="bi bi-images"></i>No images match these filters.</div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="table table-hover admin-table align-middle">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th></th>
                        <th class="d-none d-sm-table-cell">Category</th>
                        <th>Specialist</th>
                        <th>Student</th>
                        <th class="num d-none d-md-table-cell">Terms</th>
                        <th class="num d-none d-md-table-cell">Answers</th>
                        <th class="num d-none d-md-table-cell">Groups</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var image in Model.Images.Items)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@image.Id">#@image.Id</a>
                                <div class="muted small">@image.Pmcid</div>
                                @if (image.Removed) { <span class="state state-stale"><i class="bi bi-slash-circle"></i>Removed</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(image.ImageUrl))
                                {
                                    <a asp-action="Details" asp-route-id="@image.Id"><img class="thumb" src="@image.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /></a>
                                }
                                else
                                {
                                    <span class="state state-stale"><i class="bi bi-link-45deg"></i>No link</span>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell">
                                <div>@AdminUi.Title(image.Speciality ?? "—")</div>
                                <div class="muted small">@image.Modality · @image.BodyRegion</div>
                            </td>
                            <td><partial name="_RoleStatus" model="(image.SpecialistDone, image.SpecialistHolder)" /></td>
                            <td><partial name="_RoleStatus" model="(image.StudentDone, image.StudentHolder)" /></td>
                            <td class="num d-none d-md-table-cell">@image.Keywords</td>
                            <td class="num d-none d-md-table-cell">@image.SpecialistResponses</td>
                            <td class="num d-none d-md-table-cell">@image.StudentGroups</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model='(Model.Images.Page, Model.Images.Pages, Model.Images.Total, Model.Images.PageSize, "images")' />
</section>
